{
  "name": "naintegra-lex-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Shell nativo (Capacitor) do NaIntegra Lex para Google Play e App Store",
  "scripts": {
    "sync": "bash scripts/sync-lex-www.sh",
    "build": "npm run sync && RUBYOPT=-rlogger npx cap sync",
    "prepare:native": "bash scripts/prepare-native-projects.sh",
    "export:aistudio": "bash scripts/export-for-aistudio.sh",
    "assetlinks": "python3 scripts/update-assetlinks.py",
    "signing:setup": "bash scripts/setup-android-signing.sh",
    "publish:play": "bash scripts/continue-play-publish.sh",
    "aistudio:open": "open https://aistudio.google.com/apps?source=start && open aistudio/PROMPT-COPIAR.txt && open aistudio/GUIA-TELA-A-TELA.md && open ../web/lex/icons/icon-512.png",
    "aistudio:go": "bash scripts/aistudio-go.sh",
    "aistudio:wizard": "bash scripts/aistudio-wizard.sh",
    "store:assets": "python3 scripts/generate-store-assets.py",
    "promo:assets": "python3 scripts/generate-promo-assets.py",
    "play:screenshots": "python3 scripts/export-play-screenshots.py",
    "play:screenshots:all": "python3 scripts/export-play-screenshots.py --device all",
    "play:phone-usage": "python3 scripts/export-phone-usage.py",
    "play:sha256": "bash scripts/add-play-sha256.sh",
    "play:fetch-sha256": "python3 scripts/fetch-play-sha256.py",
    "play:finish": "bash scripts/finish-play-publish.sh",
    "smoke": "python3 scripts/smoke-mobile-apps.py",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "build:aab": "bash scripts/bootstrap-android-build.sh && npm run build && bash scripts/build-release-aab.sh",
    "publish:play:upload": "python3 scripts/upload-play-console.py",
    "publish:play:upload:aab": "python3 scripts/upload-play-console.py --upload-only",
    "play:configure-closed": "python3 scripts/configure-play-closed-track.py",
    "play:setup-test-access": "python3 scripts/setup-play-test-access.py",
    "publish:play:full": "python3 scripts/publish-play-full.py",
    "publish:stores": "bash scripts/publish-stores-loop.sh",
    "play:open-closed": "bash scripts/open-play-closed-pages.sh",
    "play:complete-review": "python3 scripts/complete-play-review.py",
    "play:complete-review:fast": "PLAY_REVIEW_SKIP_FORMS=1 python3 scripts/complete-play-review.py",
    "publish:play:api": "python3 scripts/upload-play-api.py",
    "archive:ios": "bash scripts/archive-ios.sh",
    "appstore:publish": "python3 scripts/publish-app-store-full.py",
    "appstore:create-app": "python3 scripts/create-appstore-app-browser.py",
    "appstore:assets": "python3 scripts/prepare-app-store-assets.py",
    "appstore:complete-review": "python3 scripts/complete-app-store-review.py",
    "appstore:blockers": "python3 scripts/complete-app-store-review.py --blockers-only",
    "appstore:helper": "open store-assets/app-store-submit-helper.html",
    "export:android": "npm run build && npx cap open android",
    "export:ios": "npm run build && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
