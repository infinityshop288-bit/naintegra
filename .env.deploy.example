# Copie para .env.deploy e preencha (NÃO commite .env.deploy).
# Hostinger → Sites → naintegracursos.com.br → Arquivos → Detalhes FTP

# --- FTP (recomendado na Hostinger) ---
FTP_SERVER=ftp.naintegracursos.com.br
FTP_USERNAME=
FTP_PASSWORD=
FTP_PORT=21
# Raiz FTP na Hostinger costuma ser public_html; use ./lex/ se já estiver dentro de public_html
FTP_REMOTE_DIR=./public_html/lex/

# --- Dashboard PRIO3 (/xxx/) ---
# Pasta remota do painel de mercado (protegido por senha)
FTP_REMOTE_DIR_XXX=./public_html/xxx/
# Login HTTP Basic (Apache .htpasswd)
DASHBOARD_USER=infinity.shop288@gmail.com
DASHBOARD_PASSWORD=
# Caminho absoluto no servidor (hPanel → Arquivos). Se vazio, usa .htpasswd na pasta /xxx/
# HTPASSWD_ABS_PATH=/home/u123456789/domains/naintegracursos.com.br/public_html/xxx/.htpasswd

# --- SSH (opcional — Hostinger Business+) ---
# SSH_HOST=
# SSH_USERNAME=
# SSH_PRIVATE_KEY=
# SSH_PORT=65002
# SSH_REMOTE_DIR=domains/naintegracursos.com.br/public_html/lex/

# --- SMTP Hostinger (recuperação de senha via Supabase Auth + edge function auth-password-recovery) ---
# hPanel → E-mails → Conectar apps → SMTP: smtp.hostinger.com, porta 465 (SSL) ou 587 (TLS)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contato@naintegracursos.com.br
# SMTP_PASS=
# SMTP_FROM=contato@naintegracursos.com.br
# SMTP_SENDER_NAME=NaIntegra
# SUPABASE_ACCESS_TOKEN=   # Dashboard → Account → Access Tokens
#   bash scripts/configure_supabase_smtp_hostinger.sh
#   bash ../naintegracursos/scripts/configure_supabase_auth_urls.sh
