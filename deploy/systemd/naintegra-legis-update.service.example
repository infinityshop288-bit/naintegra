[Unit]
Description=NaIntegra Lex — atualização semanal da legislação (Planalto)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/naintegra
EnvironmentFile=-/opt/naintegra/.env
ExecStart=/opt/naintegra/scripts/run_legis_update_weekly.sh
Nice=10

[Install]
WantedBy=multi-user.target
