# Copie para .env e ajuste. Prefixo fixo: LEX_AGENT_

LEX_AGENT_CRAWL_INBOX_PATH=./data/crawl_inbox
LEX_AGENT_CRAWL_GLOB=*.jsonl
LEX_AGENT_ALSO_SCAN_JSON=true

# Loop principal (Railway/supervisor) ou job agendado (n8n/cron)
LEX_AGENT_POLL_INTERVAL_SECONDS=600
# false = loop contínuo | true = um ciclo e sai (útil com ``naintegra-lex-agent`` ou ``naintegra-organize-loop`` só em disco).
LEX_AGENT_RUN_ONCE=false

LEX_AGENT_MAX_RECORDS_PER_CYCLE=500
LEX_AGENT_BATCH_SIZE=50

LEX_AGENT_DRY_RUN=false

# Supabase: URL + service role key do projeto NaIntegra Cursos.
# Conteúdo Lex (legislação + jurisprudência/informativos) → public.norma_chunks via normas.py
# (não lex.ingested_documents). Padronização: sql/norma_chunks_standard.sql
# Pós-ingestão: python3 scripts/normalize_norma_corpus.py
# Persistir português jurídico (pt_norma) no Supabase após mudança de regras:
#   python3 scripts/normalize_norma_corpus.py --apply-portuguese --only-stale
#   python3 scripts/normalize_norma_corpus.py --source planalto --apply-portuguese --dry-run

# --- Atualização semanal legislação Planalto (hash) — scripts/run_legis_update_weekly.sh
# --- Pipeline LEXML semanal (descobre alterações federais → crawl_inbox → promoção Lex)
# LEX_AGENT_LEXML_CRAWL_COMMAND=  # opcional: comando naintegra-crawl externo antes da busca
# LEX_AGENT_LEXML_CRAWL_TIMEOUT_SECONDS=3600
# LEX_AGENT_LEXML_LOOKBACK_DAYS=8
# LEX_AGENT_LEXML_SEARCH_SLEEP_SECONDS=0.25
# ./scripts/run_lexml_legis_weekly.sh
# systemd: deploy/systemd/naintegra-lexml-legis-weekly.{service,timer}.example

# naintegra-norma-consolidate-loop ou ./scripts/run_norma_consolidate_loop.sh
# LEX_AGENT_TRILHANTE_INFORMATIVO_ROOT=./output_trilhante_informativo
# LEX_AGENT_NORMA_MARKDOWN_ROOTS=./output_legislacao,./output_rideel_legislacao_full/markdown
# LEX_AGENT_NORMA_AI_FORMAT_ENABLED=true
# LEX_AGENT_NORMA_AI_FORMAT_MODE=fallback
# LEX_AGENT_AI_PROVIDER=ollama
# LEX_AGENT_AI_MODEL=llama3.2
# LEX_AGENT_NORMA_CONSOLIDATE_LOOP_IDLE_CYCLES_BEFORE_EXIT=3
# LEX_AGENT_RUN_ONCE=true  # um ciclo de consolidação
# Flashcards / progresso usuário: schema lex (lex.ingested_documents é legado do agente local).

LEX_AGENT_SUPABASE_URL=
LEX_AGENT_SUPABASE_SERVICE_ROLE_KEY=
LEX_AGENT_LEX_SCHEMA=lex
LEX_AGENT_LEX_TABLE=ingested_documents
# Se aparecer PGRST106 «Invalid schema: lex»: Supabase → Project Settings → API → Exposed schemas → inclua ``lex`` (e aplique sql/lex_ingested_documents.sql).

LEX_AGENT_STATE_DB_PATH=.lex_agent/state.sqlite
LEX_AGENT_LOG_LEVEL=INFO

# Material bruto vs. organização (pastas separadas; inbox só leitura para o agente)
LEX_AGENT_RAW_PRESERVED_PATH=./data/raw_preserved
LEX_AGENT_ORGANIZED_OUTPUT_PATH=./data/organized
LEX_AGENT_PRESERVE_INBOX_FILES=true
LEX_AGENT_WRITE_ORGANIZED_MANIFEST=true
# Corpus único no clone Git (mesmo payload que lex.ingested_documents), mesclado por external_id após cada ciclo de organização.
LEX_AGENT_REPOSITORY_CORPUS_ENABLED=false
LEX_AGENT_REPOSITORY_CORPUS_PATH=./repository/lex_corpus.jsonl
# Manifesto analisado/categorizado em pasta separada (por batch_id, ex. latest/) — cada ciclo de collect_cycle.
LEX_AGENT_ANALYZED_OUTPUT_ENABLED=false
LEX_AGENT_ANALYZED_OUTPUT_PATH=./data/analyzed
# JSONL Trilhante Informativo (jurisprudência, súmulas, legislação). Fundido no corpus nos loops e em ``naintegra-trilhante-publish``.
# LEX_AGENT_TRILHANTE_INFORMATIVO_ROOT=./output_trilhante_informativo
# Upsert Supabase sem dedupe em state: LEX_AGENT_PUBLISH_IGNORE_STATE=true ou ``naintegra-trilhante-publish --force-all``
LEX_AGENT_PUBLISH_IGNORE_STATE=false

# Preview local: manifest demo + evolução por ciclo (organize/questions-loop regeneram preview/evolucao-organizacao.html).
# LEX_AGENT_SYNC_PREVIEW_MANIFEST=true já é aplicado pelos loops organize/questions via apply_loop_defaults.
LEX_AGENT_PREVIEW_EVOLUTION_ENABLED=true
LEX_AGENT_PREVIEW_EVOLUTION_JSONL_PATH=./preview/organize_evolution.jsonl
LEX_AGENT_PREVIEW_EVOLUTION_HTML_PATH=./preview/evolucao-organizacao.html
# «terminei» só abre se encerrar SEM Ctrl+C/SIGTERM, último ciclo OK e documentos < LEX_AGENT_MAX_RECORDS_PER_CYCLE (sem truncagem).
LEX_AGENT_PREVIEW_OPEN_NOTE_ON_EXIT=true
LEX_AGENT_PREVIEW_COMPLETION_NOTE_PATH=./preview/terminei.txt
# Encerrar organize/questions-loop após N ciclos seguidos com 0 docs normalizados (sem erro), para abrir «terminei» sem interromper.
LEX_AGENT_ORGANIZE_LOOP_IDLE_CYCLES_BEFORE_EXIT=0
LEX_AGENT_QUESTIONS_LOOP_IDLE_CYCLES_BEFORE_EXIT=0

# --- Loop de scraping (monitor lê data/scrape_status.json)
# Para coleta automática de questões no questions-loop use playwright_harvest (ver scripts abaixo).
# off | shell | playwright_harvest (requer: scripts/install_playwright_for_scrape.sh)
LEX_AGENT_SCRAPE_LOOP_MODE=playwright_harvest
# Alternativa sem browser: shell + LEX_AGENT_SCRAPE_LOOP_SHELL_COMMAND apontando para um crawler externo
# LEX_AGENT_SCRAPE_LOOP_MODE=shell
LEX_AGENT_SCRAPE_LOOP_INTERVAL_SECONDS=300
LEX_AGENT_SCRAPE_STATUS_PATH=./data/scrape_status.json
LEX_AGENT_SCRAPE_JOB_NAME=naintegra-scrape-loop
LEX_AGENT_SCRAPE_LOOP_SHELL_COMMAND=true
LEX_AGENT_SCRAPE_LOOP_SHELL_TIMEOUT_SECONDS=3600
# Duração de cada sessão Chromium por ciclo do questions-loop (navegue/consulte questões dentro desse tempo).
LEX_AGENT_SCRAPE_HARVEST_SECONDS=90
LEX_AGENT_SCRAPE_HARVEST_HEADED=false
# true (primeira sessão): Chromium visível — faça login em qconcursos.com; ao fim do harvest grava QC_STUDY_PLAYWRIGHT_STORAGE_STATE_PATH.
LEX_AGENT_SCRAPE_HARVEST_URL_SUBSTRING=
LEX_AGENT_SCRAPE_HARVEST_OUT=
LEX_AGENT_SCRAPE_HARVEST_APPEND=true
LEX_AGENT_SCRAPE_HARVEST_EMIT_UNKNOWN_WRONG=false
# wrong_only = só inferidas como erradas na rede | all_with_gabarito = objetivas com gabarito (+ discursivas quando aplicável).
LEX_AGENT_SCRAPE_HARVEST_EMIT_MODE=all_with_gabarito
# Goto inicial do harvest (ex.: lista «minhas questões erradas», exige sessão logada). Vazio → QC_STUDY_QCONCURSO_BASE_URL.
# LEX_AGENT_SCRAPE_HARVEST_START_URL=https://www.qconcursos.com/questoes-de-concursos/questoes?my_questions=wrong&per_page=20

# Loop scrape→fusão→normalize/manifest (inclui inbox QC_STUDY na fusão automaticamente).
# Automação: ./scripts/run_questions_loop.sh ou systemd em deploy/systemd/naintegra-questions-loop.service.example
# Pré-requisito harvest: playwright-save-state OU uma volta com LEX_AGENT_SCRAPE_HARVEST_HEADED=true (grava estado ao fim).
LEX_AGENT_QUESTIONS_LOOP_INTERVAL_SECONDS=120
# true = um ciclo scrape+collect e sai (teste / diagnóstico)
LEX_AGENT_QUESTIONS_LOOP_RUN_ONCE=false

# --- Scraping por banca × cargo (FGV, FCC, CEBRASPE, VUNESP × cargos jurídicos)
# Rode: naintegra-exam-boards-loop (só coleta JSONL; organize depois com questions-loop ou organize-loop)
# Fontes: qconcurso | techconcursos | official (homes em targets.OFFICIAL_BANK_HOME — pouco JSON).
# TecConcursos / outros: se 0 linhas, ``naintegra-qconcursos-studies playwright-observe --start-url …``
# e ajuste LEX_AGENT_EXAM_SCRAPE_URL_SUBSTRING para filtrar as URLs JSON.
LEX_AGENT_EXAM_SCRAPE_INBOX_PATH=./data/exam_scrape/inbox
LEX_AGENT_EXAM_SCRAPE_SOURCES=qconcurso,techconcursos
LEX_AGENT_EXAM_SCRAPE_PAIRS_PER_CYCLE=6
LEX_AGENT_EXAM_SCRAPE_SECONDS_PER_URL=45
LEX_AGENT_EXAM_SCRAPE_INCLUDE_OFFICIAL=false
LEX_AGENT_EXAM_SCRAPE_HEADED=false
LEX_AGENT_EXAM_SCRAPE_URL_SUBSTRING=
LEX_AGENT_EXAM_BOARDS_LOOP_INTERVAL_SECONDS=600

# --- IA (opcional): classificação / metadados; cache em LEX_AGENT_AI_CACHE_PATH replica sem novo custo
LEX_AGENT_AI_ENABLED=false
# off | fallback (só quando heurística falha) | enrich (preenche tribunal/matéria/seção) | full (sempre consulta IA)
LEX_AGENT_AI_MODE=fallback
# anthropic | openai | openai_compatible | ollama (Ollama nativo: URL default http://127.0.0.1:11434/v1 se LEX_AGENT_OPENAI_COMPATIBLE_BASE_URL vazio)
LEX_AGENT_AI_PROVIDER=anthropic
LEX_AGENT_ANTHROPIC_API_KEY=
LEX_AGENT_OPENAI_API_KEY=
# Obrigatório para openai_compatible; opcional para ollama (default local acima).
# LEX_AGENT_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# LEX_AGENT_OPENAI_COMPATIBLE_API_KEY=
LEX_AGENT_AI_MODEL=
LEX_AGENT_AI_TIMEOUT_SECONDS=90
LEX_AGENT_AI_MAX_INPUT_CHARS=12000
LEX_AGENT_AI_MAX_CALLS_PER_CYCLE=40
LEX_AGENT_AI_MIN_CONFIDENCE=0.35
LEX_AGENT_AI_FULL_DOC_OVERRIDE_THRESHOLD=0.62
LEX_AGENT_AI_CACHE_PATH=.lex_agent/ai_cache.sqlite

# --- Pipeline QConcursos.com: erros consolidados × estudo IA (opcional)
# Variáveis com prefixo QC_STUDY_ (classe QConcursoStudySettings).
QC_STUDY_QCONCURSO_BASE_URL=https://www.qconcursos.com/
QC_STUDY_PLAYWRIGHT_STORAGE_STATE_PATH=.qc_study/playwright-qconcurso.json
QC_STUDY_QCONCURSO_INBOX_PATH=./data/qconcurso/inbox
QC_STUDY_CONSOLIDATED_PATH=./data/qconcurso/wrong_consolidated.jsonl
QC_STUDY_STUDIES_DIR=./data/qconcurso/studies
QC_STUDY_REVIEW_HTML_PATH=./data/qconcurso/revisao_erradas.html
QC_STUDY_AI_PROVIDER=anthropic
QC_STUDY_ANTHROPIC_API_KEY=
QC_STUDY_OPENAI_API_KEY=
# anthropic | openai | openai_compatible | ollama — para ollama a base default é http://127.0.0.1:11434/v1 se QC_STUDY_OPENAI_COMPATIBLE_BASE_URL estiver vazio.
# QC_STUDY_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# QC_STUDY_OPENAI_COMPATIBLE_API_KEY=
QC_STUDY_AI_MODEL=
QC_STUDY_AI_TIMEOUT_SECONDS=120
QC_STUDY_AI_MAX_INPUT_CHARS=16000
QC_STUDY_AI_CALLS_DELAY_SECONDS=0.5
QC_STUDY_STUDIES_CACHE_SQLITE=.qc_study/ai_cache.sqlite
QC_STUDY_STUDY_MAX_BATCHES=200
# exam_prep (default) | cited_solution — análise com lei + jurisprudência típicas (modelo sem pesquisa web; validar em fontes oficiais).
QC_STUDY_STUDY_PROMPT_PROFILE=exam_prep
